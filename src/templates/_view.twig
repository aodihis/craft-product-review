{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}
{% set title = "Review ##{review.id}" %}


{% block details %}
    <dl class="meta read-only">
        <div class="data">
            <dt class="heading">ID</dt>
            <dd class="value">{{ review.id }}</dd>
        </div>
        {# reviewer and product can both be null: a soft-deleted element stays in the trash until
           garbage collection, so the review's foreign key has not cascaded yet. #}
        <div class="data">
            <dt class="heading">Reviewer</dt>
            <dd class="value">
                {% if review.reviewer %}
                    <a href="{{ review.reviewer.cpEditUrl }}">{{ review.reviewer.fullName ?: review.reviewer.username }}</a>
                {% else %}
                    {{ 'Deleted user'|t('product-review') }}
                {% endif %}
            </dd>
        </div>
        <div class="data">
            <dt class="heading">Product</dt>
            <dd class="value">
                {% if review.product %}
                    <a href="{{ review.product.cpEditUrl }}">{{ review.product.title }}</a>
                {% else %}
                    {{ 'Removed product'|t('product-review') }}
                {% endif %}
            </dd>
        </div>
        <div class="data" >
            <dt class="heading">Variants</dt>
            <dd class="value">
                <ul>
                    {% for variant in review.variants %}
                        <li><a href={{ variant.cpEditUrl }}>{{ variant.title }}</a></li>
                    {% endfor %}
                </ul>
            </dd>
        </div>

        <div class="data" >
            <dt class="heading">Created at</dt>
            <dd class="value">{{ review.dateCreated|datetime }}</dd>
        </div>
        <div class="data">
            <dt class="heading">Updated at</dt>
            <dd class="value">{{ review.dateUpdated|datetime }}</dd>
        </div>
    </dl>
{% endblock %}


{% block content %}

    <div class="field" data-attribute="comment" >
        <div class="heading">
            <label>Rating</label>
        </div>
        {% for i in 1..review.rating %}
            <span style="font-size:150%;color:#0a0d0f;">&starf;</span>
        {% endfor %}
    </div>

    <div id="comment-field" class="field" data-attribute="comment" >
        <div class="heading">
            <label id="comment-label" for="comment">Comment</label></div>
        <div class="input ltr">
            {{ review.comment ? review.comment|purify|raw : 'No Feedback'|t('product-review') }}
        </div>
    </div>


{% endblock content %}