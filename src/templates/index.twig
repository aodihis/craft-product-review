{% extends "_layouts/cp" %}
{% import "_includes/forms.twig" as forms %}

{% set title = "Product Review"|t('product-review') %}

{% do view.registerAssetBundle('craft\\web\\assets\\admintable\\AdminTableAsset') -%}

{% css %}
    /* Layout only. Everything else is Craft's own field and element select styling, so the
       filters match the rest of the control panel and follow it through theme changes. */
    .pr-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 24px;
        align-items: flex-start;
        margin-bottom: 24px;
    }

    .pr-filters .field {
        margin: 0;
        flex: 1 1 220px;
        min-width: 0;
    }

    .pr-filters .pr-filter-rating {
        flex: 0 1 140px;
    }
{% endcss %}

{% block content %}
    <div class="pr-filters">
        {{ forms.elementSelectField({
            label: "Reviewer"|t('product-review'),
            id: 'reviewer-filter',
            name: 'reviewer',
            elementType: 'craft\\elements\\User',
            single: true,
            selectionLabel: "Choose a customer"|t('product-review'),
        }) }}

        {{ forms.elementSelectField({
            label: "Product"|t('product-review'),
            id: 'product-filter',
            name: 'product',
            elementType: 'craft\\commerce\\elements\\Product',
            single: true,
            selectionLabel: "Choose a product"|t('product-review'),
        }) }}

        {{ forms.selectField({
            label: "Rating"|t('product-review'),
            id: 'rating-filter',
            name: 'rating',
            fieldClass: 'pr-filter-rating',
            options: [{ label: "Any"|t('product-review'), value: '' }]|merge(
                (1..maxRating)|map(i => { label: i, value: i })
            ),
        }) }}
    </div>

    <div id="table-data"></div>
{% endblock %}

{% js %}
var selectedProductId = null;
var selectedReviewerId = null;
var selectedRating = null;

var columns = [
    { name: 'product', title: Craft.t('app', 'Product'), callback: function(product) {
            if (product) {
                return reviewLink(product.cpEditUrl, product.title);
            }
            return '';
        } },
    { name: 'rating', title: Craft.t('app', 'Rating'), callback: function (rating) {
            return '<span style="font-size:150%;color:#0a0d0f;">&starf;</span>'.repeat(rating);
        } },
    { name: 'comment', title: Craft.t('app', 'Comment'), callback: function (comment) {
            // VueAdminTable writes cell content via innerHTML, and the comment is
            // reviewer-supplied — escape it. Truncation would split tags anyway.
            var text = Craft.escapeHtml(comment);
            return (text.length > 25) ? text.slice(0, 100-1) + '&hellip;' : text;
        } },
    { name: 'reviewer', title: Craft.t('app', 'Reviewer'), callback: function(reviewer) {
            if (reviewer) {
                return reviewLink(reviewer.cpEditUrl, reviewer.name);
            }
            return '';
        } },
    { name: 'url', title: '',
        callback: function(url) {
            if (url) {
                return `<a href="${Craft.escapeHtml(url)}" class="view-btn btn" aria-label="View">${Craft.t('app', 'View')}</a>`;
            }
            return '';
        }
    }
];

// VueAdminTable writes cell content via innerHTML, so anything interpolated has to be escaped.
// cpEditUrl is empty when the element has been deleted but the review row survives, so render a
// plain label in that case rather than a link to nowhere.
function reviewLink(url, label) {
    var text = Craft.escapeHtml(label || '');
    return url ? `<a href="${Craft.escapeHtml(url)}">${text}</a>` : text;
}

const adminTable = new Craft.VueAdminTable({
    container: '#table-data',
    padded: true,
    columns: columns,
    tableDataEndpoint: 'product-review/review-cp/get-table-data',
    onQueryParams: function(params) {
        params.productId = selectedProductId;
        params.reviewerId = selectedReviewerId;
        params.rating = selectedRating;

        return params;
    },
});

/**
 * Returns the ID of the element currently chosen in an element select, or null.
 *
 * Craft's element select adds its hidden inputs from JavaScript once something is chosen, so the
 * chip's data-id is checked as well rather than relying on one representation being present.
 */
function chosenElementId(containerId) {
    const container = document.getElementById(containerId);

    if (!container) {
        return null;
    }

    const input = container.querySelector('input[type="hidden"][name][value]:not([value=""])');

    if (input) {
        return input.value;
    }

    const chip = container.querySelector('[data-id]');

    return chip ? chip.getAttribute('data-id') : null;
}

/**
 * Element selects are driven by Garnish, which fires its events on the JavaScript object rather
 * than the DOM, so there is nothing to bind a listener to from here. Watching the container covers
 * both choosing and removing, whatever markup Craft renders.
 */
function watchElementSelect(containerId, onChange) {
    const container = document.getElementById(containerId);

    if (!container) {
        return;
    }

    let last = chosenElementId(containerId);

    new MutationObserver(function() {
        const current = chosenElementId(containerId);

        if (current !== last) {
            last = current;
            onChange(current);
        }
    }).observe(container, { childList: true, subtree: true });
}

watchElementSelect('reviewer-filter', function(id) {
    selectedReviewerId = id;
    adminTable.reload();
});

watchElementSelect('product-filter', function(id) {
    selectedProductId = id;
    adminTable.reload();
});

document.getElementById('rating-filter').addEventListener('change', function() {
    selectedRating = this.value || null;
    adminTable.reload();
});
{% endjs %}
